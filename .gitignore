# Environments
.venv/
venv/
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Regenerable and NEVER version-controlled (PROJECT_CONTEXT.md section 4).
# data/ holds benchmarks, prompts, raw response dumps, scores. Dumps ship as a Zenodo
# artifact at release, not in git.
data/
outputs/
multirun/

# Hydra working dirs
.hydra/

# The Kaggle pilots download their output to the REPO ROOT, outside data/, so the data/ rule
# above does not catch it. `rho_responses.jsonl` is a raw response dump (2.2 MB, 1,728
# generations) and raw dumps never enter git -- they ship as a Zenodo artifact at release.
# Its canonical home is data/responses/; it is ignored here wherever it lands.
rho_responses.jsonl
pilot_results.json

# Model weights and raw dumps -- belt and braces alongside check-added-large-files.
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt
*.onnx

# results/ IS committed (small final tables + run_manifests/ + paper_numbers.json).
# Figures are regenerable but small vector files; keep the directory, ignore rasters.
figures/*.png

# OS
.DS_Store
Thumbs.db

# Machine-local Claude Code permission state — not project config.
.claude/settings.local.json
